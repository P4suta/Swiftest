#!/bin/sh
set -eu
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
module_cache=$(mktemp -d "${TMPDIR:-/tmp}/swiftest-platform-cache.XXXXXX")
trap 'rm -rf "$module_cache"' EXIT HUP INT TERM
export CLANG_MODULE_CACHE_PATH="$module_cache"
export SWIFTPM_MODULECACHE_OVERRIDE="$module_cache"
cd "$project_root"
build_for()
{
    sdk_name=$1
    target_triple=$2
    sdk_path=$(xcrun --sdk "$sdk_name" --show-sdk-path)
    swift build --build-system native --disable-sandbox --disable-index-store -j 4 --target Swiftest --triple "$target_triple" --sdk "$sdk_path"
}
build_for macosx arm64-apple-macos14.0
build_for iphoneos arm64-apple-ios17.0
build_for appletvos arm64-apple-tvos17.0
build_for watchos arm64_32-apple-watchos10.0
build_for xros arm64-apple-xros1.0
echo "platforms=passed count=5"
